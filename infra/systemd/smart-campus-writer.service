[Unit]
Description=Smart Campus - Almacenamiento MQTT en InfluxDB
Wants=network-online.target
After=network-online.target mosquitto.service docker.service

[Service]
Type=simple
User=azureuser
WorkingDirectory=/home/azureuser/smart-campus-iot
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/azureuser/smart-campus-iot/.venv/bin/python /home/azureuser/smart-campus-iot/servicios/mqtt_a_influx.py
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
