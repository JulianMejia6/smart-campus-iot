[Unit]
Description=Smart Campus - Reproductores de datasets
Wants=network-online.target
After=network-online.target mosquitto.service

[Service]
Type=simple
User=azureuser
WorkingDirectory=/home/azureuser/smart-campus-iot
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/azureuser/smart-campus-iot/.venv/bin/python /home/azureuser/smart-campus-iot/dispositivos/reproductor_datasets.py
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
